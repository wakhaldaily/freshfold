{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freshfold-pos",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // Demo PINs (1234/0000/2222) and admin@freshfold.test only work when this is "true".
    // Keep it "false" for any store using real customer data.
    "ALLOW_DEMO_ACCOUNTS": "false"
  }
  // DATABASE_URL is a secret: `npx wrangler secret put DATABASE_URL` (never commit it).
}
